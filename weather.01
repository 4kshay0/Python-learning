          "name": "stdout",
          "text": [
            "Request successful!\n",
            "location: Hyderabad (lat: 17.3850, long: 78.4867)\n",
            "Time: 2026-08-12T16:15\n",
            "Temperature: 24.2C\n",
            "Wind Speed: 12.1 km/h\n"
          ]
        }
      ],
      "source": [
        "import requests\n",
        "\n",
        "url = \"https://api.open-meteo.com/v1/forecast?latitude=17.3850&longitude=78.4867&current_weather=true\"\n",
        "\n",
        "response = requests.get(url)\n",
        "if response.status_code ==200:\n",
        "  data=response.json()\n",
        "  print(\"Request successful!\")\n",
        "\n",
        "else:\n",
        "  print(f\"Failed to fetch data. Error code: {response.status_code}\")\n",
        "\n",
        "current= data['current_weather']\n",
        "temp= current['temperature']\n",
        "wind= current['windspeed']\n",
        "time_recorded= current['time']\n",
        "\n",
        "print(f\"location: Hyderabad (lat: 17.3850, long: 78.4867)\")\n",
        "print(f\"Time: {time_recorded}\")\n",
        "print(f\"Temperature: {temp}C\")\n",
        "print(f\"Wind Speed: {wind} km/h\")"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "df=pd.DataFrame([current])\n",
        "display(df)"
      ],
