      ],
      "source": [
        "import requests\n",
        "import pandas as pd\n",
        "\n",
        "cities = [{\"city\": \"Hyderabad\" , \"lat\": 17.3850, \"lon\":78.4867},\n",
        "          {\"city\": \"Mumbai\",\"lat\": 19.0760, \"lon\": 72.8777},\n",
        "          {\"city\": \"Delhi\", \"lat\": 28.6137, \"lon\": 77.2090}]\n",
        "\n",
        "weather_list=[]\n",
        "\n",
        "for location in cities:\n",
        "  url=f\"https://api.open-meteo.com/v1/forecast?latitude={location['lat']}&longitude={location['lon']}&current_weather=true\"\n",
        "  response = requests.get(url)\n",
        "\n",
        "  if response.status_code == 200:\n",
        "    data = response.json()['current_weather']\n",
        "    data['city'] = location['city']\n",
        "    weather_list.append(data)\n",
        "\n",
        "  df_cities = pd.DataFrame(weather_list)\n",
        "\n",
        "  df_cities = df_cities[['city' , 'temperature' , 'windspeed' , 'time']]\n",
        "  display(df_cities)"
      ]
    },
    {
